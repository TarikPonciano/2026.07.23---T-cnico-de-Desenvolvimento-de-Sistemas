# Copie este arquivo com o nome .env (sem o ".exemplo") e preencha com os dados da Aiven.
# Onde achar: console.aiven.io > seu serviço > Overview > Connection information.
# O .env NÃO vai para o GitHub: o .gitignore do repositório já o ignora.
DB_HOST=pg-seu-servico-seu-projeto.a.aivencloud.com
DB_PORT=12345
DB_NAME=cinema
DB_USER=avnadmin
DB_PASSWORD=cole_a_senha_aqui
DB_SSLMODE=require
